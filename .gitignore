# Terraform working directories and state
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Terraform crash logs
crash.log
crash.*.log

# Variable files may contain secrets
*.tfvars
*.tfvars.json

# Local plans and CLI configuration
*.tfplan
.terraformrc
terraform.rc

# Override files are intended for local use
override.tf
override.tf.json
*_override.tf
*_override.tf.json
